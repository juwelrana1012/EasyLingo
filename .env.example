# GEMINI_API_KEY: Required for Gemini AI API calls (Smart Translator, Dictionary, Grammar Checker, Speaking Feedback, AI Quizzes).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies for user authentication.
SESSION_SECRET="lingobangla-dev-session-secret-change-in-production"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
